# ── Database (Neon) ────────────────────────────────────────────────
# App runtime uses the POOLED connection; migrations use the DIRECT one.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# ── Server ─────────────────────────────────────────────────────────
# PORT is provided automatically by Railway; only set locally if needed.
# PORT=3000

# ── Auth ───────────────────────────────────────────────────────────
JWT_SECRET="change-me-long-random-string"
GOOGLE_CLIENT_ID="xxxxx.apps.googleusercontent.com"

# ── Admin seed (npm run seed) ──────────────────────────────────────
ADMIN_EMAIL="admin@galleryq.com"
ADMIN_PASSWORD="change-me"
ADMIN_FULLNAME="Platform Admin"

# ── Planned integrations (used by upcoming modules) ────────────────
# ImageKit (images)
IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT=""

# Stripe (wallet top-up + Connect payouts)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email notifications (Nodemailer SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="GalleryQ <no-reply@galleryq.com>"

# Phone OTP
OTP_EXP_MINUTES="5"
OTP_MAX_ATTEMPTS="5"
