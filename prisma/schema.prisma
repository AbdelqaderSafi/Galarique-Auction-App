// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// =====================================================================
//  ENUMS
// =====================================================================

enum AuthProvider {
  LOCAL
  GOOGLE
  APPLE
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

// حالة القطعة الفنية (كيان دائم)
enum ObjectStatus {
  DRAFT // تحت الإنشاء (wizard لم يكتمل)
  AVAILABLE // متاحة (غير معروضة بمزاد)
  IN_AUCTION // معروضة بمزاد قائم
  SOLD // بِيعت
}

// حالة المزاد
enum AuctionStatus {
  DRAFT // مسوّدة (البائع يبني)
  PENDING_REVIEW // أُرسِل — بانتظار موافقة الأدمن
  REJECTED // رفضه الأدمن (مع سبب)
  LIVE // قائم (بدأ لحظة الموافقة)
  ENDED // انتهى الوقت (قيد الحسم)
  SOLD // بِيع ودُفع
  UNSOLD // لم يُبَع (لا مزايدات / أقل من الاحتياطي / تخلّف الجميع)
  CANCELLED // ملغى
}

// حالة العربون ($50)
enum DepositStatus {
  HELD // محجوز
  RELEASED // أُرجِع
  FORFEITED // صودِر (تخلّف عن الدفع)
}

// حالة الطلب — دورة Escrow مبسّطة (بدون شحن)
enum OrderStatus {
  AWAITING_PAYMENT // بانتظار دفع الفائز (مهلة 72 ساعة) = Unpaid
  PAID_IN_ESCROW // دُفع والمال في الحجز بانتظار تأكيد الاستلام = Paid
  COMPLETED // المشتري أكّد الاستلام أو تحرّر تلقائياً → المال للبائع
  DISPUTED // بلاغ نزاع — المال مجمّد بانتظار الإدارة
  REFUNDED // أُعيد المال للمشتري
  DEFAULTED // تخلّف الفائز عن الدفع (→ second-chance)
  CANCELLED // ملغى
}

// حالة النزاع
enum DisputeStatus {
  OPEN // مفتوح — بانتظار الإدارة
  RESOLVED_BUYER // حُسِم لصالح المشتري (استرداد)
  RESOLVED_SELLER // حُسِم لصالح البائع (تحرير)
}

// حالة طلب السحب (عبر Stripe Connect/Payouts)
enum WithdrawalStatus {
  PENDING // قيد المعالجة
  PAID // حُوِّل بنجاح
  FAILED // فشل
}

// نوع حركة المحفظة
enum WalletTxnType {
  TOPUP // شحن (عبر البوابة)
  WITHDRAW // سحب
  DEPOSIT_HOLD // حجز عربون $50
  DEPOSIT_RELEASE // إرجاع العربون
  DEPOSIT_FORFEIT // مصادرة العربون
  ESCROW_IN // دفع المشتري → الحجز
  ESCROW_RELEASE // الحجز → محفظة البائع (بعد الاستلام/التحرير التلقائي)
  REFUND // استرجاع للمشتري
}

// =====================================================================
//  USERS / PROFILE / WALLET
// =====================================================================

model User {
  id         String       @id @default(uuid())
  fullName   String
  email      String       @unique
  password   String?
  provider   AuthProvider @default(LOCAL)
  providerId String?

  // الدور كمصفوفة، والافتراضي مشتري
  roles Role[] @default([BUYER])

  // Stripe
  stripeCustomerId String? @unique // لشحن المحفظة (PaymentIntent)
  stripeConnectId  String? @unique // لحساب الـ payouts (Stripe Connect)

  sellerProfile SellerProfile?
  wallet        Wallet?

  // العلاقات الجديدة
  objects            Object[]            @relation("OwnerObjects") // القطع التي يملكها (بائع)
  bids               Bid[] // مزايداته
  deposits           AuctionDeposit[] // عرابينه
  wonAuctions        Auction[]           @relation("AuctionWinner") // المزادات التي يتصدّرها/فاز بها حالياً
  reviewedAuctions   Auction[]           @relation("AuctionReviewer") // المزادات التي راجعها كأدمن
  buyerOrders        Order[]             @relation("BuyerOrders") // طلباته كمشتري
  sellerOrders       Order[]             @relation("SellerOrders") // طلباته كبائع
  disputes           Dispute[] // النزاعات التي رفعها
  phoneVerifications PhoneVerification[] // أكواد تحقّق الهاتف
  passwordResets     PasswordReset[] // أكواد إعادة تعيين كلمة المرور
  withdrawals        Withdrawal[] // طلبات السحب
  favoriteObjects    FavoriteObject[] // مفضّلة القطع
  favoriteAuctions   FavoriteAuction[] // مفضّلة المزادات
  following          Follow[]            @relation("Following") // الباعة الذين يتابعهم
  followers          Follow[]            @relation("Followers") // متابعوه كبائع

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// سجل البائع الموثّق — يُنشأ عند نجاح تحقّق الهاتف (يمنح دور SELLER)
model SellerProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  phoneNumber     String   @unique // رقم فلسطيني (+970/+972) موثّق
  phoneVerifiedAt DateTime // وقت تأكيد الـ OTP

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// تحقّق الإيميل عند التسجيل — نخزّن بيانات التسجيل مؤقتاً هنا
// ولا نُنشئ User إلا بعد تأكيد الرمز (OTP من 6 أرقام)
model EmailVerification {
  id         String    @id @default(uuid())
  email      String
  fullName   String
  password   String // مُجزّأة بـ argon2 (يُخزَّن الهاش لا كلمة السر)
  codeHash   String // رمز التحقق (6 أرقام) مُجزّأ
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime? // وقت الاستخدام الناجح

  createdAt DateTime @default(now())

  @@index([email])
}

// أكواد إعادة تعيين كلمة المرور (OTP من 6 أرقام عبر الإيميل)
model PasswordReset {
  id         String    @id @default(uuid())
  user       User      @relation(fields: [userId], references: [id])
  userId     String
  codeHash   String // الرمز مُجزّأ
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

// أكواد تحقّق الهاتف (OTP) — عابرة، تُستهلك عند التأكيد
model PhoneVerification {
  id         String    @id @default(uuid())
  user       User      @relation(fields: [userId], references: [id])
  userId     String
  phone      String // الرقم المُراد توثيقه (+970/+972)
  codeHash   String // الكود مُجزّأ (لا يُخزّن صراحةً)
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime? // وقت الاستخدام الناجح

  createdAt DateTime @default(now())

  @@index([userId, phone])
}

// المحفظة الموحّدة للمستخدم
model Wallet {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  // Decimal للدقة المالية
  balance       Decimal @default(0) @db.Decimal(12, 2) // المتاح للسحب/الاستخدام
  lockedBalance Decimal @default(0) @db.Decimal(12, 2) // المعلّق (عرابين مزادات قائمة)

  transactions WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletTransaction {
  id       String        @id @default(uuid())
  wallet   Wallet        @relation(fields: [walletId], references: [id])
  walletId String
  type     WalletTxnType
  amount   Decimal       @db.Decimal(12, 2)
  refId    String? // مرجع (auctionId / orderId)
  note     String?

  createdAt DateTime @default(now())

  @@index([walletId, createdAt])
}

// طلب سحب رصيد — يُنفَّذ عبر Stripe Connect/Payouts
model Withdrawal {
  id             String           @id @default(uuid())
  user           User             @relation(fields: [userId], references: [id])
  userId         String
  amount         Decimal          @db.Decimal(12, 2)
  status         WithdrawalStatus @default(PENDING)
  stripePayoutId String? // مرجع التحويل من Stripe

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

// =====================================================================
//  CATALOG: CATEGORY / OBJECT
// =====================================================================

// التصنيفات ثابتة (enum) — لا جدول
enum Category {
  ART
  WATCHES
  COLLECTIBLES
  JEWELRY
  FURNITURE
  BOOKS
  FASHION
  ELECTRONICS
}

// القطعة الفنية — كيان دائم يمكن أن يُعرض بأكثر من مزاد
model Object {
  id      String @id @default(uuid())
  owner   User   @relation("OwnerObjects", fields: [ownerId], references: [id])
  ownerId String

  category Category

  title       String
  description String? // اختياري — قد لا تُجمَع في خطوة Details
  mainImage   String // الصورة الرئيسية (الغلاف) — تظهر بالواجهة (صورة واحدة)
  images      ObjectImage[] // صور إضافية توضح المنتج (حتى 10)

  // تفاصيل القطعة (من Create › Details + Product)
  era         String? // مثل 18th Century
  condition   String?
  originality String?
  heightCm    Decimal? @db.Decimal(8, 2)
  widthCm     Decimal? @db.Decimal(8, 2)
  depthCm     Decimal? @db.Decimal(8, 2)

  status ObjectStatus @default(DRAFT)

  auctions  Auction[]
  favorites FavoriteObject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([category])
}

model ObjectImage {
  id       String @id @default(uuid())
  object   Object @relation(fields: [objectId], references: [id], onDelete: Cascade)
  objectId String
  url      String
  position Int    @default(0)
}

// =====================================================================
//  AUCTION / BID / DEPOSIT
// =====================================================================

model Auction {
  id       String @id @default(uuid())
  object   Object @relation(fields: [objectId], references: [id])
  objectId String

  // التسعير (من Set Value + ثغرات نضيفها بالباك اند)
  startingPrice   Decimal  @db.Decimal(12, 2) // سعر الافتتاح = أقل سعر للبيع
  minBidIncrement Decimal  @default(50) @db.Decimal(12, 2) // الحد الأدنى للزيادة
  currentPrice    Decimal  @default(0) @db.Decimal(12, 2) // أعلى مزايدة حالياً

  currentWinner   User?   @relation("AuctionWinner", fields: [currentWinnerId], references: [id])
  currentWinnerId String?

  // التوقيت + التمديد التلقائي (anti-snipe)
  durationDays     Int // المدة المختارة (3/5/7/10) — تبدأ عند الموافقة
  startTime        DateTime? // تُضبط عند موافقة الأدمن
  endTime          DateTime? // = startTime + durationDays
  antiSnipeSeconds Int       @default(60) // لو جت مزايدة بآخر X ثانية
  extendBySeconds  Int       @default(60) // مدّد X ثانية

  // مراجعة الأدمن
  reviewedBy      User?     @relation("AuctionReviewer", fields: [reviewedById], references: [id])
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?

  viewsCount Int           @default(0)
  status     AuctionStatus @default(DRAFT)

  bids      Bid[]
  deposits  AuctionDeposit[]
  orders    Order[] // أكثر من طلب ممكن (second-chance)
  favorites FavoriteAuction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, endTime])
  @@index([objectId])
}

model Bid {
  id        String  @id @default(uuid())
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  auctionId String
  bidder    User    @relation(fields: [bidderId], references: [id])
  bidderId  String
  amount    Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([auctionId, amount]) // لترتيب المزايدات وإيجاد الأعلى
  @@index([bidderId])
}

// عربون $50 لكل مزايد بمزاد — يُحجز عند أول مزايدة
model AuctionDeposit {
  id        String        @id @default(uuid())
  auction   Auction       @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  auctionId String
  user      User          @relation(fields: [userId], references: [id])
  userId    String
  amount    Decimal       @default(50) @db.Decimal(12, 2)
  status    DepositStatus @default(HELD)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([auctionId, userId]) // عربون واحد لكل مزايد بالمزاد
}

// =====================================================================
//  ORDER (يُنشأ عند الفوز) — يدعم second-chance
// =====================================================================

model Order {
  id        String  @id @default(uuid())
  auction   Auction @relation(fields: [auctionId], references: [id])
  auctionId String

  buyer    User   @relation("BuyerOrders", fields: [buyerId], references: [id])
  buyerId  String
  seller   User   @relation("SellerOrders", fields: [sellerId], references: [id])
  sellerId String

  amount         Decimal @db.Decimal(12, 2) // السعر النهائي (يُحرَّر للبائع)
  depositApplied Decimal @default(50) @db.Decimal(12, 2) // العربون المُحتسب
  amountDue      Decimal @db.Decimal(12, 2) // amount - depositApplied (يدفعه المشتري)
  offerRank      Int     @default(1) // 1=الفائز، 2=ثاني أعلى... (second-chance)

  status OrderStatus @default(AWAITING_PAYMENT)

  // الدفع (Escrow) — بدون شحن
  paymentDeadline DateTime // الآن + 72 ساعة لدفع الفائز
  paidAt          DateTime? // وقت الدفع ودخول المال للحجز

  // التحرير
  autoReleaseAt DateTime? // paidAt + مدّة → تحرير تلقائي إن لم يؤكّد المشتري ولا رفع نزاع
  completedAt   DateTime? // وقت تأكيد الاستلام/التحرير

  dispute Dispute?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([auctionId])
  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([status, autoReleaseAt]) // لمهمة التحرير التلقائي
}

// نزاع على طلب — تحسمه الإدارة (تحرير للبائع أو استرداد للمشتري)
model Dispute {
  id         String        @id @default(uuid())
  order      Order         @relation(fields: [orderId], references: [id])
  orderId    String        @unique
  raisedBy   User          @relation(fields: [raisedById], references: [id])
  raisedById String
  reason     String
  status     DisputeStatus @default(OPEN)
  adminNote  String?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

// =====================================================================
//  FAVORITES / FOLLOW
// =====================================================================

model FavoriteObject {
  id       String @id @default(uuid())
  user     User   @relation(fields: [userId], references: [id])
  userId   String
  object   Object @relation(fields: [objectId], references: [id], onDelete: Cascade)
  objectId String

  createdAt DateTime @default(now())

  @@unique([userId, objectId])
}

model FavoriteAuction {
  id        String  @id @default(uuid())
  user      User    @relation(fields: [userId], references: [id])
  userId    String
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  auctionId String

  createdAt DateTime @default(now())

  @@unique([userId, auctionId])
}

// متابعة بائع (= Fav Sellers)
model Follow {
  follower   User   @relation("Following", fields: [followerId], references: [id])
  followerId String
  seller     User   @relation("Followers", fields: [sellerId], references: [id])
  sellerId   String

  createdAt DateTime @default(now())

  @@id([followerId, sellerId])
}
