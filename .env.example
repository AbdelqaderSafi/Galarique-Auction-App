# ── Database (Neon) ────────────────────────────────────────────────
# App runtime uses the POOLED connection; migrations use the DIRECT one.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# ── Server ─────────────────────────────────────────────────────────
# PORT is provided automatically by Railway; only set locally if needed.
# PORT=3000

# ── Auth ───────────────────────────────────────────────────────────
JWT_SECRET="change-me-long-random-string"
GOOGLE_CLIENT_ID="xxxxx.apps.googleusercontent.com"

# رابط الواجهة الأمامية (يُستخدم في رابط إعادة تعيين كلمة المرور)
FRONTEND_URL="http://localhost:3000"

# ── Admin seed (npm run seed) ──────────────────────────────────────
ADMIN_EMAIL="admin@galleryq.com"
ADMIN_PASSWORD="change-me"
ADMIN_FULLNAME="Platform Admin"

# ── Planned integrations (used by upcoming modules) ────────────────
# ImageKit (images)
IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT=""

# Stripe (wallet top-up + Connect payouts)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email notifications (Brevo HTTP API)
# مفتاح API من Brevo (يبدأ بـ xkeysib-)
BREVO_API_KEY=""
# لازم يكون sender موثّق في حساب Brevo
MAIL_FROM="GalleryQ <no-reply@galleryq.com>"

# OTP codes (email verification + WhatsApp seller verification)
OTP_EXP_MINUTES="5"
OTP_MAX_ATTEMPTS="5"

# WhatsApp seller verification (Baileys — free). Session folder, optional
# (default ./wa-auth). On Railway mount a Volume here to persist it.
WHATSAPP_AUTH_DIR="./wa-auth"
# Set the bot's WhatsApp number (international, no +) to link via an 8-char
# pairing code instead of scanning a QR. Example: 970599123456
WHATSAPP_PAIRING_NUMBER=""
# Set to "false" during local dev to skip connecting (avoids the repeated
# "Finished syncing" phone notification on every nest --watch restart).
# OTP codes are logged to the console instead. Default: enabled.
WHATSAPP_ENABLED="true"
# Seller verification simulation: when "true", POST /seller/request-verification
# (and /resend) return the code in the response instead of sending via WhatsApp,
# so the app can display it. NOT secure — demo/simulation only. Default: off.
SELLER_OTP_SIMULATE="false"
